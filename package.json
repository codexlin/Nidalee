{
  "name": "nidalee",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "build": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run test && pnpm run build-only",
    "build:analyze": "cross-env ANALYZE=true pnpm build-only",
    "build:prod": "cross-env NODE_ENV=production pnpm run build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "types": "node scripts/prepare-types.mjs && cd src-tauri && cargo test --all-targets --locked && cd .. && node scripts/sync-types.mjs",
    "types:sync": "node scripts/sync-types.mjs",
    "types:check": "pnpm run types && git diff --exit-code -- src/types/global.d.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt src/",
    "format:check": "oxfmt src/ --check"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.83.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@vueuse/core": "^13.3.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "0.526.0",
    "motion-v": "^1.6.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.3.0",
    "radash": "^12.1.1",
    "reka-ui": "^2.3.0",
    "shadcn-vue": "^2.2.0",
    "tailwind-merge": "^3.3.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.4",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.0.0",
    "culori": "^4.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^8.2.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-vue-devtools": "^8",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nidalee",
  "version": "2.0.0",
  "identifier": "com.nidalee.lol-assistant",
  "build": {
    "removeUnusedCommands": true,
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1422",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Nidalee - 高性能、体积小巧的智能英雄联盟游戏助手",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://ddragon.leagueoflegends.com https://raw.communitydragon.org https://static.developer.riotgames.com wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'unsafe-inline' 'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1422 ws://localhost:1422 https://127.0.0.1:* https://ddragon.leagueoflegends.com https://raw.communitydragon.org https://static.developer.riotgames.com wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'unsafe-inline' 'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../src/assets/fonts/harmonyos-sans-sc/LICENSE.txt": "licenses/HarmonyOS-Sans-SC-LICENSE.txt"
    },
    "externalBin": [],
    "copyright": "Copyright © 2024 Nidalee Team. All rights reserved.",
    "category": "Game",
    "shortDescription": "高性能、体积小巧的智能英雄联盟游戏助手",
    "longDescription": "Nidalee 是一个高性能、体积小巧的智能英雄联盟游戏助手，提供实时游戏数据分析、自动化功能和个性化设置。",
    "publisher": "Nidalee Team",
    "homepage": "https://github.com/codexlin/Nidalee",
    "licenseFile": "../LICENSE",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "tsp": false,
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "dialog": null
  }
}
